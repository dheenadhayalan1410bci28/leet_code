int captureForts(int* forts, int fortsSize) {
    int lft, rgt, res = 0;
    
    for (lft = rgt = 0; rgt < fortsSize; rgt++) {
        if (forts[rgt] != 0) {
            if (forts[lft] == -forts[rgt] && res < rgt - lft - 1) res = rgt - lft - 1;
            lft = rgt;
        }
    }

    return res;
}
