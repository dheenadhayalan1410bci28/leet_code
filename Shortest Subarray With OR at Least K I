int minimumSubarrayLength(int* nums, int numsSize, int k) {
    if (k == 0) return 1;

    int sum = 0;
    int left = 0, right = 0;
    int min = INT_MAX;

    while (right < numsSize) {
        sum |= nums[right];

        while (sum >= k) {
            int size = right - left + 1;
            min = fmin(min, size);

            // re-calculate the sum
            sum = 0;
            for (int i = left + 1; i <= right; ++i) {
                sum |= nums[i];
            }
            ++left;
        }

        ++right;
    }

    return min == INT_MAX ? -1 : min;
}
