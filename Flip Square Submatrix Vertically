/**
 * Return an array of arrays of size *returnSize.
 * The sizes of the arrays are returned as *returnColumnSizes array.
 * Note: Both returned array and *columnSizes array must be malloced, assume caller calls free().
 */
int** reverseSubmatrix(int** grid, int gridSize, int* gridColSize, int x, int y, int k, int* returnSize, int** returnColumnSizes) 
{
    int** res = malloc(gridSize*sizeof(int*));
    for(int i = 0;i < gridSize; i++)
    {
        res[i] = malloc((*gridColSize)*sizeof(int));
    }
    for(int i = 0;i < gridSize; i++)
    {
        for(int j = 0;j < (*gridColSize);j++)
        {
            res[i][j] = grid[i][j];
        }
    }  
    //reverse k x k matrix  
    for(int i = 0;i < k; i++)
    {
        for(int j=0 ; j<k; j++)
        {
            res[x + i][y + j] = grid[x + (k - 1 - i)][y + j];
        }
    }
    //set the return values
    *returnSize=gridSize;
    *returnColumnSizes=malloc(gridSize*sizeof(int*));
    for(int i=0 ; i<gridSize ;i++)
    {
         (*returnColumnSizes)[i]=*gridColSize;
    }
    return res;
}
