#include <stdlib.h>

int cmp(const void* a, const void* b) {
    return (*(int*)a - *(int*)b);
}

double minimumAverage(int* nums, int numsSize) {
    qsort(nums, numsSize, sizeof(int), cmp);

    double min_avg = 1e18;
    int j = numsSize - 1;

    for (int i = 0; i < numsSize / 2; i++) {
        double avg = (nums[i] + nums[j]) / 2.0;
        if (avg < min_avg)
            min_avg = avg;
        j--;
    }

    return min_avg;
}
