void processString(char* str) {
    int k = 0;
    for (int i = 0; str[i] != '\0'; i++) {
        if (str[i] != '#') {
            str[k++] = str[i];
        } else if (k > 0) {
            k--;
        }
    }
    str[k] = '\0';
}
bool backspaceCompare(char* s, char* t) {
    processString(s);
    processString(t);
    return strcmp(s, t) == 0;
}
