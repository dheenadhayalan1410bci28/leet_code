#pragma GCC optimize("O3, unroll-loops")
#define N 64
#define swap(x, y) {int* tmp=(x); (x)=(y); (y)=tmp;}
const int mask=63, bshift=6;
int freq[N];

void radix_sort(int* nums, int n) {
    int* output = (int*)alloca(n * sizeof(int));  // buffer
    unsigned M=0;
    for(int i=0; i<n; i++) 
        if(nums[i]>M) M=nums[i];

    const int Mround=fmax(1, (31-__builtin_ctz(M)+bshift)/bshift);
    int* in=nums;
    int* out=output;
    bool swapped=0;

    for (int round=0; round<Mround; round++) {
        const int shift=round*bshift;
        memset(freq, 0, sizeof(freq));

        for (int i = 0; i < n; i++)
            freq[(in[i] >> shift) & mask]++;

        for(int i=1; i<N; i++) freq[i]+=freq[i-1];
       
        for (int i = n - 1; i >= 0; i--) {
            uint64_t val = in[i];
            uint64_t x = (val >> shift) & mask;
            out[--freq[x]] = val;
        }

        swap(in, out);
        swapped = !swapped;
    }

    // If needed, copy back
    if (swapped)
        memcpy(nums, in, n * sizeof(int));
}
static int minimumDifference(int* nums, int n, int k) {
    if (k==1) return 0; 
    radix_sort(nums, n);
    int diff=INT_MAX;
    for(int l=0, r=k-1; r<n; r++, l++){
        diff=fmin(diff, nums[r]-nums[l]);
    }
    return diff;
}
