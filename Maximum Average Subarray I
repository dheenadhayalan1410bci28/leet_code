double findMaxAverage(int* nums, int numsSize, int k) {

    int left = 0;
    double avg = -DBL_MAX;
    int sum = 0;

    for (int right = 0; right < numsSize; right++) {

        if (right - left + 1 > k) {
            sum -= nums[left];
            left++;
        }

        sum += nums[right];

        if (right - left + 1 == k) {
            avg = fmax(avg, (double)sum / k);
        }
    }

    return avg;
}
