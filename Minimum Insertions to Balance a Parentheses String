int minInsertions(char* s) {
    int temp = 0, res = 0;
    bool need = false;

    for (int i = 0; s[i] != '\0'; i++) {
        char ch = s[i];

        if (ch == '(') {
            if (need) {
                res++;
                need = false;
            }
            temp++;
        }
        else {
            if (need) {
                need = false;
            }
            else {
                if (temp == 0) {
                    temp++;
                    res++;
                }
                temp--;
                need = true;
            }
        }
    }

    if (need)
        res++;

    res += temp * 2;
    return res;
}
