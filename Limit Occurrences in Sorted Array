int* limitOccurrences(int* nums, int n, int k, int* r) {
    int *res = malloc(n * sizeof(int));
    int a = 0,c=0;
    for(int i = 0; i < n; i++)
    {
        if(i==0||nums[i] == nums[i-1])
        {
            c++;
        }
        else
        {
            c = 1;
        }

        if(c <= k)
        {
            res[a] = nums[i];
            a++;
        }
    }

    *r = a;
    return res;
}
