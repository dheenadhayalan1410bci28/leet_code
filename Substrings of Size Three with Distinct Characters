int check(char a,char b,char c){
    if(a!=b && b!=c && c!=a){
        return 1;
    }
    return 0;
}

int countGoodSubstrings(char *s)
{
    int count = 0;
    int n = strlen(s);
    for(int i=0;i<n-2;i++){
        if(check(s[i],s[i+1],s[i+2])){
            count++;
        }
    }
    return count;
}
