long long findTheArrayConcVal(int* nums, int n) {
    long long sum=0;
    for(int i=0,j=n-1;i<=j;j--,i++){
       long long int temp=nums[j],digit=1;
        while(temp>0){
            temp=temp/10;
            digit*=10;
        }
        if(i==j){
            sum+=nums[i];
            break;
        }
        sum+=((nums[i]*digit)+nums[j]);
    }
    return sum;
}
